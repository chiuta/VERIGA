#!/bin/bash
# shellcheck disable=SC2154  # variabilele ($app, $install_dir, $data_dir) sunt injectate de YunoHost
source /usr/share/yunohost/helpers

ynh_script_progression "Removing Link Guardian timer..."
systemctl disable --now "$app-watch.timer" 2>/dev/null || true
ynh_safe_rm "/etc/systemd/system/$app-watch.timer"
ynh_safe_rm "/etc/systemd/system/$app-watch.service"
systemctl daemon-reload

ynh_script_progression "Removing NGINX web server configuration..."
ynh_config_remove_nginx

ynh_script_progression "Removal of $app completed"
